<Window x:Class="Revolution.Could.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revolution · 腾讯云资源发布" Width="1060" Height="850" MinWidth="760" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F5F7FC" FontFamily="Microsoft YaHei UI"
        Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="960" Margin="28,26,28,35">
            <StackPanel>
                <TextBlock Text="REVOLUTION  /  CLOUD PUBLISHER" FontSize="11" FontWeight="Bold" Foreground="#5979C8" Margin="2,0,0,10"/>
                <TextBlock Text="让每一次热更，都稳稳抵达。" FontSize="27" FontWeight="SemiBold" Foreground="#172746" Margin="0,0,0,5"/>
                <TextBlock Text="从 Unity 产物到腾讯云 COS，一个清晰可控的发布流程。" Foreground="#71819C" Margin="0,0,0,22"/>

                <Border x:Name="IntroCard" CornerRadius="18" Margin="0,0,0,18" Padding="28,24" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1D397B" Offset="0"/>
                            <GradientStop Color="#315CDD" Offset="0.65"/>
                            <GradientStop Color="#4879E8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border Background="#35FFFFFF" CornerRadius="12" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,13">
                                <TextBlock Text="安全发布向导" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="资源先就位，清单最后发布" FontSize="21" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Unity 打包并自检 → 选择产物 → 校验路径 → 上传 COS。全程不保存密钥。"
                                       Foreground="#DCE8FF" Margin="0,9,0,0" MaxWidth="580" LineHeight="21"/>
                        </StackPanel>
                        <!-- 只使用 WPF 原生几何元素，不依赖额外图标字体或在线图片。 -->
                        <Canvas Grid.Column="1" Height="130" Width="185" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Width="140" Height="140" Canvas.Left="35" Canvas.Top="-5" Fill="#1DFFFFFF"/>
                            <Ellipse Width="100" Height="100" Canvas.Left="55" Canvas.Top="15" Stroke="#65FFFFFF" StrokeThickness="1.5"/>
                            <Ellipse Width="62" Height="62" Canvas.Left="74" Canvas.Top="34" Fill="#40FFFFFF"/>
                            <TextBlock Text="↑" FontSize="37" FontWeight="Light" Foreground="White" Canvas.Left="91" Canvas.Top="34"/>
                        </Canvas>
                    </Grid>
                </Border>

                <Border x:Name="SourceCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,5">
                            <Border x:Name="SourceBadge" DockPanel.Dock="Left" Background="#EBF0FF" CornerRadius="9" Width="36" Height="36" Margin="0,0,13,0">
                                <TextBlock Text="01" Foreground="#3D64CF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Title}" Text="选择 Unity 产物"/>
                                <TextBlock Foreground="#8090A7" FontSize="12" Text="从已生成的热更清单开始"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,12" Text="请选择含 RevHotManifest.txt、ResMap.txt 与 AB 包的平铺目录（通常为 AssetBundles/平台名）。不要选 LocalCDN。"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="产物目录"/>
                        <DockPanel>
                            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="浏览目录" Click="Browse_Click" Margin="0,5,0,12"/>
                            <TextBox x:Name="DirectoryBox" Margin="0,5,10,12" TextChanged="InputsChanged"/>
                        </DockPanel>
                        <Button x:Name="PreviewButton" Content="校验文件并预览路径  →" HorizontalAlignment="Left" Click="Preview_Click" Style="{StaticResource Primary}"/>
                        <Border Background="#F6F8FD" CornerRadius="9" Padding="14,12" Margin="0,18,0,0">
                            <TextBlock x:Name="PreviewText" Foreground="#445674" LineHeight="22" Text="尚未检查，请先选择产物目录。"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="CloudCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,5">
                            <Border x:Name="CloudBadge" DockPanel.Dock="Left" Background="#EBF0FF" CornerRadius="9" Width="36" Height="36" Margin="0,0,13,0">
                                <TextBlock Text="02" Foreground="#3D64CF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Title}" Text="连接腾讯云 COS"/>
                                <TextBlock Foreground="#8090A7" FontSize="12" Text="只需填写存储桶与上传凭证"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,12" Text="桶名须包含 APPID，地域以 COS 控制台为准。这里不需要填写 CDN 地址。"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="存储桶名称（Bucket）"/>
                                <TextBox x:Name="BucketBox" TextChanged="InputsChanged"/>
                                <TextBlock Style="{StaticResource Hint}" Text="例如 game-assets-1250000000"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="地域（Region）"/>
                                <TextBox x:Name="RegionBox" Text="ap-guangzhou" TextChanged="InputsChanged"/>
                                <TextBlock Style="{StaticResource Hint}" Text="例如 ap-guangzhou（广州）"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SecretId · 建议使用最小权限 CAM 子账号"/>
                        <TextBox x:Name="SecretIdBox" TextChanged="InputsChanged"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SecretKey · 仅用于本次上传，不写入本地文件"/>
                        <PasswordBox x:Name="SecretKeyBox" PasswordChanged="CredentialsChanged"/>
                        <Border Background="#FFF8EB" CornerRadius="9" Padding="13,11" Margin="0,5,0,0">
                            <TextBlock Foreground="#865C26" FontSize="12" LineHeight="19" Text="安全提示：不要把密钥放进 Unity 项目、Git 或截图。本版本需要公有读 / 私有写的桶，以便校验线上资源。"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="PublishCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,5">
                            <Border x:Name="PublishBadge" DockPanel.Dock="Left" Background="#EBF0FF" CornerRadius="9" Width="36" Height="36" Margin="0,0,13,0">
                                <TextBlock Text="03" Foreground="#3D64CF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Title}" Text="核对并发布"/>
                                <TextBlock Foreground="#8090A7" FontSize="12" Text="资源上传完成后才会提交入口清单"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,12" Text="工具会复核本地 SHA-256 与远端版本；远端同路径资源不同则拒绝覆盖。上传中请勿重新打包。"/>
                        <TextBlock x:Name="TargetText" FontWeight="SemiBold" Margin="0,0,0,14" Text="请先校验产物目录"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UploadButton" Content="确认并开始上传  →" Style="{StaticResource Primary}" IsEnabled="False" Click="Upload_Click"/>
                            <Button x:Name="CancelButton" Content="取消上传" IsEnabled="False" Click="Cancel_Click"/>
                        </StackPanel>
                        <ProgressBar x:Name="PublishProgress" Height="8" Margin="0,20,0,14" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#E9EEF8"/>
                        <DockPanel>
                            <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Text="0%" Foreground="#52688D" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,5,8,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="StatusText" Foreground="#64748B" Text="就绪"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="运行日志" FontWeight="SemiBold" Margin="0,20,0,3"/>
                        <TextBox x:Name="LogBox" Margin="0,5,0,0" Height="140" VerticalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="Wrap" Background="#F8FAFD" BorderBrush="#E8EDF5"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="REVOLUTION  ·  为每一份版本保留清晰的发布边界" FontSize="11" Foreground="#96A4BA" HorizontalAlignment="Center" Margin="0,5,0,8"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
