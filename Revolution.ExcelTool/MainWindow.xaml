<Window x:Class="Revolution.ExcelTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revolution 导表工具"
        Height="780" Width="1160"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12"
        Foreground="{StaticResource TextMain}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <!-- ==================== ① Excel 数据源 ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="① Excel 数据源" Style="{StaticResource SectionTitle}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtSource" Grid.Column="0" Style="{StaticResource PathBox}"
                             ToolTip="选择一个 .xlsx 文件，或选择装着一批 .xlsx 的目录"/>

                    <Button Grid.Column="1" Content="选择文件" Style="{StaticResource FlatButton}"
                            Margin="8,0,0,0" Click="OnPickExcelFile"/>
                    <Button Grid.Column="2" Content="选择目录" Style="{StaticResource FlatButton}"
                            Margin="8,0,0,0" Click="OnPickExcelFolder"/>
                    <Button Grid.Column="3" Content="读取" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Click="OnScan"/>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Margin="10,0,0,0" IsHitTestVisible="False"
                               Text="支持 .xlsx（Excel 2007+）；每个工作表 = 一张表">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSource}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== ② 表列表 + 预览 ==================== -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 表列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="② 表列表" Style="{StaticResource SectionTitle}"/>

                    <ListBox x:Name="LstTables" Grid.Row="1"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnTableSelected">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,7"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F2F5FA"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E8EFFD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Foreground" Value="#D93F31"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 预览 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="③ 表结构预览" Style="{StaticResource SectionTitle}"/>

                    <TextBlock x:Name="TxtPreviewInfo" Grid.Row="1" Style="{StaticResource Hint}"
                               Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="在左侧选择一张表，这里会显示字段与数据前 50 行"/>

                    <DataGrid x:Name="GridPreview" Grid.Row="2"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="All"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF1F5"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#FAFBFD"
                              FontSize="11"
                              RowHeight="22"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== ④ 输出路径 ==================== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="④ 输出路径" Style="{StaticResource SectionTitle}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="数据结构类" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtStructDir" Style="{StaticResource PathBox}"/>
                <Button    Grid.Row="1" Grid.Column="2" Content="浏览…" Style="{StaticResource FlatButton}"
                           Margin="8,0,0,0" Click="OnPickStructDir"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="容器类" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtContainerDir" Style="{StaticResource PathBox}" Margin="0,8,0,0"/>
                <Button    Grid.Row="2" Grid.Column="2" Content="浏览…" Style="{StaticResource FlatButton}"
                           Margin="8,8,0,0" Click="OnPickContainerDir"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="TXT 数据文件" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtDataDir" Style="{StaticResource PathBox}" Margin="0,8,0,0"/>
                <Button    Grid.Row="3" Grid.Column="2" Content="浏览…" Style="{StaticResource FlatButton}"
                           Margin="8,8,0,0" Click="OnPickDataDir"/>

                <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="生成文件名：RevDataStructures.cs / RevDataTables.cs / 每张表一个 &lt;表名&gt;.txt。数据文件建议放到资源系统根目录的 Data 下（运行时逻辑路径 Data/&lt;表名&gt;），由资源系统统一读取。"/>
            </Grid>
        </Border>

        <!-- ==================== ⑤ 操作 ==================== -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="开始导出" Style="{StaticResource PrimaryButton}" Click="OnExport"/>

            <TextBlock x:Name="TxtStatus" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                       Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="就绪"/>
        </Grid>

        <!-- ==================== ⑥ 日志 ==================== -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="⑥ 日志" Style="{StaticResource SectionTitle}"/>
                <TextBox x:Name="TxtLog" Grid.Row="1" Style="{StaticResource LogBox}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
